<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep iOS Key Shadow -->
    <item android:left="1dp" android:right="1dp" android:top="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="#50000000" />
        </shape>
    </item>
    <!-- iOS Dark Mode Pop-up Surface (#636366) -->
    <item android:left="1dp" android:right="1dp" android:top="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#636366" />
            <stroke android:width="0.75dp" android:color="#25FFFFFF" />
        </shape>
    </item>
</layer-list>
