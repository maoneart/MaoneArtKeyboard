<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ios_bg_light">

    <!-- Top Toolbar & Candidate Suggestion Bar -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ios_toolbar_light"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Translate Quick Button -->
        <ImageButton
            android:id="@+id/btnQuickTranslate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_icon_ripple"
            android:src="@drawable/ic_translate"
            android:contentDescription="Live Translate" />

        <!-- Clipboard Quick Button -->
        <ImageButton
            android:id="@+id/btnQuickClipboard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_icon_ripple"
            android:src="@drawable/ic_clipboard"
            android:contentDescription="Clipboard History" />

        <!-- Candidate Suggestions Row -->
        <LinearLayout
            android:id="@+id/candidatesRow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/candidate1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/ios_key_text_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#448E8E93" />

            <TextView
                android:id="@+id/candidate2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/ios_key_text_light"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#448E8E93" />

            <TextView
                android:id="@+id/candidate3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/ios_key_text_light"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Language Switch Badge (ID / EN) -->
        <TextView
            android:id="@+id/badgeLanguage"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:background="@drawable/key_bg_special_light"
            android:text="ID"
            android:textColor="@color/ios_key_text_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Settings Quick Button -->
        <ImageButton
            android:id="@+id/btnQuickSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_icon_ripple"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Live Translate Expansion Strip (Visible when translate is toggled ON) -->
    <LinearLayout
        android:id="@+id/translateStrip"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#15007AFF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTranslateStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Live Translate: ID ➔ EN"
            android:textColor="@color/ios_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseTranslate"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Selesai"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/key_bg_blue"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- Dynamic Keyboard Body Frame -->
    <FrameLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="235dp"
        android:padding="3dp" />

</LinearLayout>
